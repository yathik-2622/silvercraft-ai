# ─────────────────────────────────────────────────────────────────────────────
# SilverCraft AI — Backend Environment Configuration
# Copy this file to .env and replace all REPLACE_WITH_* values.
# Per ADM_2.0_BUILD_SPEC.md §4.1 — datastore roles and secrets management.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB (system of record for all app-layer state) ───────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=silvercraft

# ── App Security ─────────────────────────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_64_CHARS

# ── LLM Provider (platform default — OpenAI-compatible endpoint) ──────────────
# Users can override per-session via Settings modal (BYO-key, per BUILD_SPEC §1.2)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=REPLACE_WITH_PLATFORM_LLM_API_KEY
LLM_MODEL=gpt-4o

# ── Redis (Celery broker + result backend + WebSocket pub/sub) ────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── S3-compatible Blob Store (MinIO locally; swap for AWS S3 in production) ───
BLOB_STORE_ENDPOINT=http://localhost:9000
BLOB_STORE_ACCESS_KEY=minioadmin
BLOB_STORE_SECRET_KEY=minioadmin
BLOB_STORE_BUCKET=silvercraft-files
BLOB_STORE_REGION=us-east-1

# ── PostgreSQL Metastore (EXPLICIT PUSH TARGET ONLY — not the app DB) ─────────
# Per BUILD_SPEC §4.1 Exception #1.
# This is ONLY written to when an owner clicks "Push to Metastore" at the final gate.
# The application NEVER reads from here during normal pipeline execution.
POSTGRES_HOST=REPLACE_WITH_POSTGRES_HOST
POSTGRES_PORT=5432
POSTGRES_USER=REPLACE_WITH_POSTGRES_USER
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_DB=silvercraft_metastore
POSTGRES_SCHEMA=public

# ── Neo4j Knowledge Graph (EXPLICIT PUSH TARGET ONLY) ─────────────────────────
# Per BUILD_SPEC §4.1 Exception #2 — 27-level KG ontology (adm_silver_kg_v2.py).
# This is ONLY written to when an owner clicks "Push to KG" at the final gate.
NEO4J_URI=REPLACE_WITH_NEO4J_BOLT_URI
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j

# ── A2A Protocol (Agent-to-Agent, per AGENT_ARCH_V2 §2.2) ────────────────────
# Optional — only needed when exposing agents to external A2A callers
A2A_PUBLIC_BASE_URL=https://your-api.example.com
A2A_SHARED_SECRET=REPLACE_WITH_SHARED_SECRET

# ── GitHub Integration (Push to Git feature) ──────────────────────────────────
# Optional platform-level token; users can also supply per-request
GITHUB_TOKEN=REPLACE_WITH_GITHUB_PERSONAL_ACCESS_TOKEN
GITHUB_DEFAULT_BRANCH=main

# ── Embeddings ──────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
