# Platform default — configured by the deployment operator, not in the UI.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=silvercraft
SECRET_KEY=replace-with-a-long-random-secret
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-platform-provider-key
LLM_MODEL=gpt-4o

# Optional: required only when exposing A2A endpoints to other services.
A2A_PUBLIC_BASE_URL=https://your-api.example.com
A2A_SHARED_SECRET=replace-with-shared-secret
