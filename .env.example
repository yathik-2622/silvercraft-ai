# ── MongoDB (your live cluster) — Cosmos DB replacement ──────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<your-cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=adm2

# ── Atlas Vector Search — Azure AI Search replacement ─────────────────────
# Two indexes, two collections — both created manually in the Atlas UI,
# names here must match exactly what you name them there.
VECTOR_INDEX_NAME=modeling_reference_vector_index
SKILL_VECTOR_INDEX_NAME=skills_vector_index
VECTOR_EMBEDDING_DIM=1536

# ── Redis — local Docker container, queue + Pub/Sub only ─────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM gateway (OpenAI-compatible) ───────────────────────────────────────
LLM_BASE_URL=<your-gateway-base-url>
LLM_API_KEY=<your-actual-key-goes-here-never-committed>
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ── Local artifact storage — Blob Storage replacement ─────────────────────
# Generated artifacts only (DDL/STTM/JSON) — never user source data.
ARTIFACT_STORAGE_DIR=./local_blob_storage

# ── Knowledge Base ingestion — admin upload chunking defaults ─────────────
KB_CHUNK_SIZE=1500
KB_CHUNK_OVERLAP=200

# ── App ────────────────────────────────────────────────────────────────────
ENV=local
LOG_LEVEL=INFO
DISTINCT_COUNT_APPROX_THRESHOLD=1000000

# ── JWT auth — generate your own, don't reuse this placeholder ───────────
JWT_SECRET_KEY=<run: python -c "import secrets; print(secrets.token_hex(32))">
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Admin — comma-separated usernames trusted as admin, deployment-level.
# No Mongo field, no promotion script: register the account normally, add
# its username here, restart the API, log in again.
ADMIN_USERNAMES=